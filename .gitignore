# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sensitive data dumps & backups
/src/lib/master_cidadaos_data.json
*.dump.sql
*.seed.json

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars
# scratch / temporary scripts
scratch/
test_*.js
*.test.js
scripts/
bun.lock
bun.lockb
package-lock.json
