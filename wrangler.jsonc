{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cras-cko",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banco-cidadaos-cko",
      "database_id": "54fc80c4-f8da-4462-8521-34e6bffceee0"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cras-cko"
    }
  ]
}
